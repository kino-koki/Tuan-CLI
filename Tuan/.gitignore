node_modules/
# dist 为构建产物，不入库。
# 但 tauri-build 在生成资源归档时会用 `git ls-files` 列举前端文件，
# 若 dist 被完全忽略会导致前端资源无法嵌入 exe（表现为窗口白屏）。
# 因此这里保留 dist 的"未跟踪但可列举"状态：negate 让 git 仍能看到文件。
dist/*
!dist/
!dist/index.html
!dist/assets/
!dist/assets/**
!dist/icons/
!dist/icons/**
!dist/data/
!dist/data/**
!dist/avatars/
!dist/avatars/**
src-tauri/target/
src-tauri/gen/
*.log
.DS_Store
# 运行时产物 / 大体积权重（不入库；与 Tuan-CLI 父仓库习惯一致）
engine/models/
engine/tts_output/
engine/custom_voices/
engine/logs/
engine/.venv/
tsconfig.tsbuildinfo
hs_err_pid*.log
replay_pid*.log
__pycache__/
*.pyc

# ── 隐私 / 开发中文件（防误上传; 与引擎运行时 .tuanignore 规则一致）──
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*password*
*passwd*
*secret*
*.secret
*credential*
*api*key*
*待办*
*代办*
*todo*.md
*.tmp
*.bak
*.orig
*.swp
*~
