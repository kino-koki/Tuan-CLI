# ===== 截图 / 本地归档（不入库） =====
_shots/
_repo_archive/
# Web 工作台渲染缓存: HTML/图片被切片渲染成 png + 抽取的 text.md + 目录 manifest。
# 内容含本机绝对路径 (E:\Qingxiaotuan Agent CLI\_preview_tmp\...), 是本地临时产物,
# 8.9MB 纯图片, 对使用者毫无价值。v0.3.1 起从版本库中移除 (曾误提交 308 个文件)。
.preview/
# 根目录偶发截图不入库（测评页 tuan-全面测评-*.html 是项目有意入库的文档，不忽略）
联想截图_*.png
截图_*.png
Screenshot_*.png

# ===== 运行时状态 (只锚定仓库根, 避免误杀 tuan_cli/ 包内同名源码目录) =====
# v0.3.1 修复: 旧规则 `audit/` `cron/` `sessions/` `memories/` 不带前导 /,
# 会把包内源码 tuan_cli/audit/ tuan_cli/cron/ 也误忽略 (cron 插件、审计存储
# 都是要入库的功能代码, 不是运行时落盘)。现在全部锚到仓库根。
/.tuan/
# .qxt/ 是代理运行时状态目录 (config/ledger/sessions/web_sessions/project/memory.db),
# 内容含本机绝对路径与用户对话记录, 绝不入库。历史上 7 个文件曾误提交。
/.qxt/
# SD 探针与 ACL 恢复报告: 本地诊断产物, 含本机路径, 不入库。
/.tuan_sd_probe/
/recovery/
# 注: 数据 (~/.tuan/) 不在仓库内, 无需忽略; git 不做 home 目录展开,
#     `~/.tuan/` 会被当作字面量目录名, 匹配不到任何东西, 故不设此规则。
/audit/
/sessions/
/memories/
/cron/
# 注: 用户技能在 ~/.tuan/skills (不在仓库内, 无需忽略);
#     resources/skills/builtin 是随包分发的资源, 必须入库, 故不设 skills/ 全局忽略。

# ===== 敏感信息 =====
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets.*
# 注意: .env.example 是含占位符的模板, 必须保留在版本库中供用户复制,
# 因此显式豁免 (上面的 .env.* 模式不会匹配 .example, 但此处声明意图以防误加模式)。
!.env.example

# ===== 日志 =====
*.log
logs/

