# 青小团密钥 / 配置模板 (env template)
# 复制为 ~/.qingxiaotuan/.env 并填入真实值 (不要提交 .env 到版本库; .env.example 才进版本库)
#
# 获取地址:
#   DeepSeek: https://platform.deepseek.com/api_keys
#   OpenAI:   https://platform.openai.com/api-keys
#   通义千问: https://dashscope.console.aliyun.com/apiKey
#   智谱:     https://open.bigmodel.cn/usercenter/apikeys
#   月之暗面: https://platform.moonshot.cn/console/api-keys
#   Groq:     https://console.groq.com/keys
#   SiliconFlow: https://cloud.siliconflow.cn/account/ak
#
# 注意: 为开源版本，不包含任何预配置的 API Key。
# 变量命名统一为 <PROVIDER>_API_KEY; 代码按 model.api_key_env 读取, 缺失时回退 QXT_API_KEY。

# ---- 主流 Provider (取消注释并填入) ----
# DeepSeek (推荐, 高性价比)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# OpenAI / 任意 OpenAI 兼容端点 (base_url 可在 qxt 里用 --base-url 覆盖)
OPENAI_API_KEY=sk-your-openai-key-here

# 通义千问 (国内)
# DASHSCOPE_API_KEY=sk-your-qwen-key-here

# 智谱 GLM
# ZHIPU_API_KEY=your-zhipu-key-here

# 月之暗面 Kimi
# MOONSHOT_API_KEY=sk-your-moonshot-key-here

# Groq (超快推理)
# GROQ_API_KEY=gsk_your-groq-key-here

# SiliconFlow (开源模型)
# SILICONFLOW_API_KEY=sk-your-siliconflow-key-here

# ---- 通用回退 (若未设置上面的专用变量, 会读取此值) ----
# QXT_API_KEY=sk-xxx

# ---- 可选: 配置目录 / 工作区 (高级) ----
# 默认 ~/.qingxiaotuan; 设置后可把密钥与配置集中到自定义目录。
# 注意: 必须以绝对路径给出, 且目录权限应限制为当前用户 (600)。
# QXT_HOME=/path/to/your/qxt-home
